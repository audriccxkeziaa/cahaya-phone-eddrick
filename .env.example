# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# CORS & FRONTEND
# Isi domain Vercel frontend di sini
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET=your_super_secret_jwt_key_here

# ============================================
# WHATSAPP (Fonnte fallback — optional)
# WA Client (whatsapp-web.js) sudah terintegrasi di backend
# Fonnte hanya dipakai sebagai fallback jika WA Client tidak aktif
# ============================================
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_KEY=your_fonnte_api_key

# ============================================
# GOOGLE CONTACTS (OAuth 2.0)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/google/callback

# ============================================
# MAIL (Optional — untuk forgot password)
# ============================================
# MAIL_USER = Gmail pengirim email reset (sama dgn email admin penerima link).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=cahayaphone288@gmail.com
MAIL_PASS=your_app_password

# ============================================
# PROVIDER WHATSAPP
#
#   baileys (default) → kirim lewat wa-bridge, tidak resmi, gratis
#   cloud             → Meta Cloud API resmi, berbayar per pesan
#
# Rollback dari Cloud API cukup kembalikan nilai ini ke 'baileys' lalu restart.
# ============================================
WA_PROVIDER=baileys

# --- Diisi HANYA kalau WA_PROVIDER=cloud ---
# Server menolak start kalau mode cloud aktif tapi empat variabel wajib
# (PHONE_NUMBER_ID, ACCESS_TOKEN, APP_SECRET, VERIFY_TOKEN) belum lengkap.
META_API_VERSION=v21.0
# Dari WhatsApp Manager → nomor yang terdaftar
META_PHONE_NUMBER_ID=
META_WABA_ID=
# WAJIB token System User permanen. Token sementara dari halaman Getting Started
# hanya berumur 24 jam dan akan mematikan produksi mendadak.
META_ACCESS_TOKEN=
# App Dashboard → Settings → Basic → App Secret. Dipakai memverifikasi
# tanda tangan webhook (X-Hub-Signature-256).
META_APP_SECRET=
# String bebas buatan sendiri. Harus sama dengan yang diisi di kolom
# "Verify Token" saat mendaftarkan Callback URL webhook di App Dashboard.
META_VERIFY_TOKEN=

# Nama template yang sudah di-approve Meta. Kosongkan untuk memakai default
# di backend/config/wa-templates.js.
META_TPL_LANG=id
META_TPL_AUTO_REPLY=konfirmasi_data_masuk
META_TPL_BIRTHDAY=ucapan_ulang_tahun
META_TPL_BROADCAST=promo_umum
